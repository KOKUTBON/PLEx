# PLEx Environment Configuration Template
# Copy this file to .env for local overrides if needed.
# None of these variables are required for standard local analysis or testing.

# CI / GitHub Actions Integration (Optional)
# Used by PLEx for commit provenance and PR comment integration.
# In GitHub Actions, these are automatically provided by the runner.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_SERVER_URL=https://github.com
GITHUB_SHA=
CI_COMMIT_SHA=

# Test Coverage Upload (Optional)
# Used in CI workflows to publish coverage to Codecov.
CODECOV_TOKEN=

# Release and Publishing (Optional)
# Set to 'true' in repository variables when triggering PyPI publication.
PUBLISH_PYPI=false

# Git Hook Integration (Optional)
# Specify custom Python executable path for native git pre-commit hook execution.
# Defaults to the Python executable active when 'plex hook install' was run.
PLEX_PYTHON=
