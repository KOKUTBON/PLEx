{
  "name": "jsts_command_injection_bench",
  "target_rule": "xbnd.command-injection",
  "min_precision": 0.95,
  "min_recall": 0.90,
  "require_zero_regressions": true,
  "corpus_dir": "../corpora/jsts_web_security",
  "cases": [
    {
      "file": "vuln_cmd.js",
      "expected_rule": "xbnd.command-injection",
      "should_detect": true,
      "expect_repairable": true
    },
    {
      "file": "safe_cmd.js",
      "expected_rule": "xbnd.command-injection",
      "should_detect": false,
      "expect_repairable": false
    }
  ]
}
