{
  "name": "python_authorization_bench",
  "target_rule": "xbnd.missing-authorization",
  "min_precision": 0.95,
  "min_recall": 0.90,
  "require_zero_regressions": true,
  "corpus_dir": "../corpora/python_authorization",
  "cases": [
    {
      "file": "vuln_authz.py",
      "expected_rule": "xbnd.missing-authorization",
      "should_detect": true,
      "expect_repairable": true,
      "test_cmd": "python3 -m pytest test_vuln_authz.py -q"
    },
    {
      "file": "safe_authz.py",
      "expected_rule": "xbnd.missing-authorization",
      "should_detect": false,
      "expect_repairable": false
    }
  ]
}
