{
  "name": "python_insecure_cookie_bench",
  "target_rule": "xbnd.insecure-cookie",
  "min_precision": 0.95,
  "min_recall": 0.90,
  "require_zero_regressions": true,
  "corpus_dir": "../corpora/python_web_security",
  "cases": [
    {
      "file": "vuln_insecure_cookie.py",
      "expected_rule": "xbnd.insecure-cookie",
      "should_detect": true,
      "expect_repairable": false
    },
    {
      "file": "safe_insecure_cookie.py",
      "expected_rule": "xbnd.insecure-cookie",
      "should_detect": false,
      "expect_repairable": false
    }
  ]
}
