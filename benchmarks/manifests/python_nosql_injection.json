{
  "name": "python_nosql_injection_bench",
  "target_rule": "xbnd.nosql-injection",
  "min_precision": 0.95,
  "min_recall": 0.90,
  "require_zero_regressions": true,
  "corpus_dir": "../corpora/python_injection",
  "cases": [
    {
      "file": "vuln_nosql.py",
      "expected_rule": "xbnd.nosql-injection",
      "should_detect": true,
      "expect_repairable": true,
      "test_cmd": "python3 -m pytest test_nosql.py -q"
    },
    {
      "file": "safe_nosql.py",
      "expected_rule": "xbnd.nosql-injection",
      "should_detect": false,
      "expect_repairable": false
    }
  ]
}
