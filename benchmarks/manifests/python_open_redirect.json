      "should_detect": true,
      "expect_repairable": true,
      "test_cmd": "python3 -m pytest test_open_redirect.py -q"
    },
    {
      "file": "safe_open_redirect.py",
      "expected_rule": "xbnd.open-redirect",
      "should_detect": false,
      "expect_repairable": false
    }
  ]
}
