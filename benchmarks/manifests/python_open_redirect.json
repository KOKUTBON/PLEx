{
  "name": "python_open_redirect_bench",
  "target_rule": "xbnd.open-redirect",
  "min_precision": 0.95,
  "min_recall": 0.90,
  "require_zero_regressions": true,
  "corpus_dir": "../corpora/python_web_security",
  "cases": [
    {
      "file": "vuln_open_redirect.py",
