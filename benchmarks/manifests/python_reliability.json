{
  "name": "python_reliability_bench",
  "target_rule": "rel.unclosed-resource",
  "min_precision": 0.95,
  "min_recall": 0.90,
  "require_zero_regressions": true,
  "corpus_dir": "../corpora/python_reliability",
  "cases": [
    {
      "file": "vuln_unclosed.py",
      "expected_rule": "rel.unclosed-resource",
      "should_detect": true,
      "expect_repairable": true,
      "test_cmd": "python3 -m pytest test_unclosed.py -q"
    },
    {
      "file": "safe_unclosed.py",
      "expected_rule": "rel.unclosed-resource",
      "should_detect": false,
      "expect_repairable": false
    }
  ]
}
