{
  "name": "python_xss_bench",
  "target_rule": "xbnd.xss",
  "min_precision": 0.95,
  "min_recall": 0.90,
  "require_zero_regressions": true,
  "corpus_dir": "../corpora/python_web_security",
  "cases": [
    {
      "file": "vuln_xss.py",
      "expected_rule": "xbnd.xss",
      "should_detect": true,
      "expect_repairable": true,
      "test_cmd": "python3 -m pytest test_xss.py -q"
    },
    {
      "file": "safe_xss.py",
      "expected_rule": "xbnd.xss",
      "should_detect": false,
      "expect_repairable": false
    }
  ]
}
