{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PLEx Project Graph Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_digest",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "target_digest": {
      "type": "string"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "properties",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "symbol",
              "call_site",
              "source",
              "sink",
              "data_class",
              "route",
              "service",
              "dependency",
              "artifact",
              "finding",
              "hypothesis",
              "patch_candidate",
              "verification_run"
            ]
          },
          "label": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          },
          "digest": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "kind",
          "producer",
          "confidence",
          "evidence_ref",
          "metadata"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "contains",
              "calls",
              "flows_to",
              "reaches",
              "authenticates",
              "depends_on",
              "maps_to",
              "detects",
              "repairs",
              "verifies",
              "correlates"
            ]
          },
          "producer": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  }
}
